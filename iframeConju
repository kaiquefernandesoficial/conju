<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
import { getMessaging, getToken } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-messaging.js';

const app = initializeApp({ /* seu firebaseConfig */ });
const VAPID = 'SUA_CHAVE_VAPID';
const iframeConju = document.querySelector('iframe'); // ajuste

function avisarApp(msg) { iframeConju.contentWindow.postMessage(msg, '*'); }

async function obterToken() {
  const reg = await navigator.serviceWorker.register('firebase-messaging-sw.js');
  return getToken(getMessaging(app), { vapidKey: VAPID, serviceWorkerRegistration: reg });
}

window.addEventListener('message', async (e) => {
  const d = e.data || {};
  if (d.tipo === 'conju-push-estado') {
    if (!('Notification' in window)) return avisarApp({ tipo: 'conju-push', estado: 'indisponivel' });
    if (Notification.permission === 'granted') {
      try { avisarApp({ tipo: 'conju-push', estado: 'ativo', token: await obterToken() }); }
      catch (err) { avisarApp({ tipo: 'conju-push', estado: 'erro' }); }
    } else {
      avisarApp({ tipo: 'conju-push', estado: Notification.permission === 'denied' ? 'negado' : 'inativo' });
    }
  }
  if (d.tipo === 'conju-push-ativar') {
    // o navegador exige um toque na própria página da casca, não vale o toque dentro do iframe
    const b = document.createElement('button');
    b.textContent = '🔔 Toque para permitir notificações';
    b.style.cssText = 'position:fixed;left:50%;bottom:90px;transform:translateX(-50%);z-index:9999;padding:14px 20px;border:0;border-radius:14px;background:#0f766e;color:#fff;font-size:15px;font-weight:600';
    b.onclick = async () => {
      b.remove();
      const p = await Notification.requestPermission();
      if (p !== 'granted') return avisarApp({ tipo: 'conju-push', estado: 'negado' });
      try { avisarApp({ tipo: 'conju-push', estado: 'ativo', token: await obterToken() }); }
      catch (err) { avisarApp({ tipo: 'conju-push', estado: 'erro' }); }
    };
    document.body.appendChild(b);
  }
});
</script>
